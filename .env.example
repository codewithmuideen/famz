# Copy this file to .env and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code — never put secrets here.

# Endpoint for the contact form, once a backend/service (e.g. Formspree, custom API) is connected.
VITE_CONTACT_FORM_ENDPOINT=

# Public analytics ID (e.g. GA4 / Plausible), only loaded if the visitor accepts analytics cookies.
VITE_ANALYTICS_ID=

# Supabase project (Settings -> API in the Supabase dashboard).
# The anon/publishable key is safe to expose client-side by design — access
# control is enforced by Row Level Security policies in Postgres, not by
# keeping this key secret. Never put the service_role key or DB password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
